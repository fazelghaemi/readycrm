# Allow uploads but restrict file types
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|doc|docx|xls|xlsx|txt)$">
    Require all granted
</FilesMatch>

# Deny access to PHP files in uploads
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# Deny access to executable files
<FilesMatch "\.(exe|bat|cmd|com|pif|scr|vbs|js|jar|sh|pl|py|rb|ps1)$">
    Require all denied
</FilesMatch>

# Disable PHP execution
php_flag engine off

# Disable directory browsing
Options -Indexes

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
