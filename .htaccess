# --- امنیت پایه ---
Options -Indexes

# فایل‌های حساس
<FilesMatch "^(composer\.(json|lock)|\.env|\.env\..*|phpunit\.xml|.*\.(sql|sh)|install\.php)$">
  Require all denied
</FilesMatch>

# بستن دسترسی HTTP به کتابخانه‌ها و پوشه‌های داخلی
RewriteEngine On
# includes و MessageWayPHP و vendor و storage و scripts از وب دیده نشوند
RewriteRule ^(includes|MessageWayPHP|vendor|storage|scripts)/ - [F,L]

# محافظت اضافه روی فایل‌های PHP داخل این پوشه‌ها (اگر ریرایت غیر فعال شد)
RewriteRule ^(includes|MessageWayPHP|vendor|storage|scripts)/.*\.(php|phar|inc)$ - [F,L]

# (اختیاری) اجبار HTTPS
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
